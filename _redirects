# Cloudflare Pages redirects
# Route .html extensions to clean canonical URLs (301)
/index.html                /                               301
/about.html                /about/                         301
/contact.html              /contact/                       301
/privacy.html              /privacy/                       301
/services.html             /services/                      301
/locations.html            /locations/                     301
/blog.html                 /blog/                          301
/services/:slug.html       /services/:slug/                301
/locations/:slug.html      /locations/:slug/               301
/blog/:slug.html           /blog/:slug/                    301
